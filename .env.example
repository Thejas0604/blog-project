# Copy to .env on the server (never commit .env). Read by docker-compose.yml.
# Generate with: openssl rand -hex 32  (min 32 chars and 8+ distinct characters in production)
JWT_SECRET=
# NODE_ENV is forced to production by docker-compose.yml (it overrides any value set here). DB_PATH is set in the Dockerfile (/app/data/blog.db); leave it unset.
# Optional: name of the private network shared only with Caddy (default: blog-net)
# BLOG_NETWORK=blog-net
# Optional: Express "trust proxy" (default 1 = one proxy hop, Caddy). A number of hops,
# or a subnet/IP string such as 172.18.0.0/16, to trust only that proxy.
# TRUST_PROXY=1
