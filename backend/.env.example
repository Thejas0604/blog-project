PORT=3000
# At least 32 characters in production. Generate with: openssl rand -hex 32
JWT_SECRET=
DB_PATH=./data/blog.db
# Optional: where uploaded images are stored (default: uploads/ next to the DB file)
# UPLOAD_DIR=./data/uploads
# Dev only: the frontend origin allowed by CORS (never loaded in production)
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
