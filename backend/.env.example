PORT=3000
# At least 32 characters unless NODE_ENV is development or test; placeholders like change-me are rejected there. Generate with: openssl rand -hex 32
JWT_SECRET=
DB_PATH=./data/blog.db
# Optional: where uploaded images are stored (default: uploads/ next to the DB file)
# UPLOAD_DIR=./data/uploads
# Optional: Express "trust proxy" (default 1 = one proxy hop, e.g. Caddy). A number of hops,
# or an IP/subnet string such as 172.18.0.0/16. Set 0 when exposed without a proxy.
# TRUST_PROXY=1
# Dev only: the frontend origin allowed by CORS (never loaded in production)
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
